# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/build/
/android/app/debug
/android/app/profile
/android/app/release

# Local Supabase credentials (keep the anon key out of source control)
env.local.json
# MMPay sandbox keys, read only by tool/mmpay_sandbox_probe.ts
mmpay.local.json

# Any dotenv file, anywhere. The named rules above cover what exists today;
# this one covers what someone adds at 2am. A local Supabase stack writes
# supabase/functions/.env for `functions serve`, and that file holds the same
# payment secrets as production.
.env
.env.*
!.env.example

# Android Play upload signing (never commit)
android/key.properties
*.jks
*.keystore

# Personal Claude Code settings (per-developer deploy permissions, etc.)
.claude/settings.local.json
.claude/launch.json

# Supabase CLI local state (linked project ref, pooler connection url, etc.)
supabase/.temp/
supabase/.branches/

# FVM Version Cache
.fvm/